# Frontend environment example — copy to frontend/.env.local (never commit .env.local)

# Backend API endpoint (defaults to local FastAPI server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mock data switch: set to "false" to use live backend data
NEXT_PUBLIC_USE_MOCKS=false

# Optional development tools
NEXT_PUBLIC_SHOW_DEV_CREDS=false

# Cloudinary unsigned upload configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
